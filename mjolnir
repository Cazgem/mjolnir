#!/usr/bin/env bash
#
#######################
#                     #
#    DIVISI LABS      #
#  MJOLNIR v 1.1.4    #
#                     #
#######################
#
# This script creates and manages Apache2 virtual hosts.

set -uo pipefail

### PARAMETERS ###
WEBDIR="/srv/www"
APACHE="/etc/apache2"
AVAILABLE="$APACHE/sites-available"
ENABLED="$APACHE/sites-enabled"
EMAIL="webmaster@divisilabs.com"
URL="${1:-}"
ACTION="${2:-}"
DEV="dev.$URL"
WEBSITENAME="${URL%.*}"
EXT="${URL#*.}"
LOGSDIR="/etc/mjolnir/logs"
RUN_AS_USER="${SUDO_USER:-$USER}"
PUBLIC_REPO_URL="https://github.com/Cazgem/mjolnir"
PUBLIC_RAW_URL="https://raw.githubusercontent.com/Cazgem/mjolnir/main/mjolnir"
DRYRUN=0
SELF_INSTALL=0
SELF_UPDATE=0

if [[ "${2:-}" == "-dryrun" || "${2:-}" == "--dry-run" ]]; then
	DRYRUN=1
	ACTION="${3:-}"
elif [[ "${3:-}" == "-dryrun" || "${3:-}" == "--dry-run" ]]; then
	DRYRUN=1
	ACTION="${2:-}"
fi

if [[ "$URL" == "-" && -z "${2:-}" ]]; then
	SELF_INSTALL=1
fi

if [[ "$URL" == "--self-update" ]]; then
	SELF_UPDATE=1
fi

usage() {
	cat <<'EOF'
Usage: mjolnir <domain.tld> <option>
[-A] assets dirs | [-F] full | [-SSL/-C] certbot SSL certificate | [-FC] full w/ certbot SSL certificate | [-I] Create Index | [-R] Remove Site | [-D] Create Dev Site | [-V] Rewrite VirtualHost | [-configtest] Apache config test
Optional: add -dryrun (or --dry-run) before/after option to preview changes without applying.
Self-install: sudo bash mjolnir -
Self-update from git checkout: sudo mjolnir --self-update
Self-update fallback from public repo: sudo mjolnir --self-update
EOF
}

warn() {
	echo "[WARN] $*" >&2
}

die() {
	echo "[ERROR] $*" >&2
	exit 1
}

run_cmd() {
	if [[ "$DRYRUN" -eq 1 ]]; then
		echo "[DRYRUN] $*"
		return 0
	fi
	"$@"
}

self_install() {
	local src target existed
	src="$(readlink -f "${BASH_SOURCE[0]}")"
	target="/usr/bin/mjolnir"
	existed=0

	if [[ ! -f "$src" ]]; then
		die "Unable to locate script source for install: $src"
	fi

	if [[ -e "$target" ]]; then
		existed=1
	fi

	run_cmd install -m 755 "$src" "$target"
	if [[ "$existed" -eq 1 ]]; then
		echo "Reinstalled mjolnir to $target"
	else
		echo "Installed mjolnir to $target"
	fi
}

self_update_from_git() {
	local src dir repo_root target
	src="$(readlink -f "${BASH_SOURCE[0]}")"
	dir="$(dirname "$src")"
	target="/usr/bin/mjolnir"

	if ! command -v git >/dev/null 2>&1; then
		warn "git not found; falling back to public source update"
		self_update_from_url
		return 0
	fi

	repo_root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)"
	if [[ -z "$repo_root" ]]; then
		warn "No git checkout detected for running script; falling back to public source update"
		self_update_from_url
		return 0
	fi

	if [[ "$DRYRUN" -ne 1 ]]; then
		if [[ -n "$(git -C "$repo_root" status --porcelain)" ]]; then
			die "Git checkout has local changes. Commit/stash first, then retry self-update."
		fi
	fi

	echo "Updating mjolnir from git repo: $repo_root"
	if ! run_cmd git -C "$repo_root" pull --ff-only; then
		warn "Git pull failed; falling back to public source update"
		self_update_from_url
		return 0
	fi

	src="$repo_root/mjolnir"
	[[ -f "$src" ]] || die "Expected script not found at $src"
	run_cmd install -m 755 "$src" "$target"
	echo "Updated mjolnir at $target"
}

self_update_from_url() {
	local target update_url tmp
	target="/usr/bin/mjolnir"
	update_url="${MJOLNIR_UPDATE_URL:-$PUBLIC_RAW_URL}"

	if [[ "$DRYRUN" -eq 1 ]]; then
		echo "[DRYRUN] download $update_url"
		echo "[DRYRUN] install -m 755 <downloaded-mjolnir> $target"
		echo "Updated mjolnir at $target (dry-run, public source)"
		return 0
	fi

	tmp="$(mktemp)"
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL "$update_url" -o "$tmp" || { rm -f "$tmp"; die "Failed to download update from $update_url"; }
	elif command -v wget >/dev/null 2>&1; then
		wget -qO "$tmp" "$update_url" || { rm -f "$tmp"; die "Failed to download update from $update_url"; }
	else
		rm -f "$tmp"
		die "curl or wget is required for public-source self-update"
	fi

	bash -n "$tmp" || { rm -f "$tmp"; die "Downloaded update failed syntax check"; }
	install -m 755 "$tmp" "$target"
	rm -f "$tmp"
	echo "Updated mjolnir at $target (public source)"
}

require_root() {
	if [[ "$DRYRUN" -eq 1 ]]; then
		warn "Dry-run mode enabled: skipping root requirement."
		return 0
	fi
	if [[ "${EUID}" -ne 0 ]]; then
		die "Run as root (for example: sudo mjolnir example.com -F)."
	fi
}

validate_domain() {
	[[ -n "$URL" ]] || die "Domain is required."
	if [[ ! "$URL" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*\.[A-Za-z]{2,}$ ]]; then
		die "Invalid domain: '$URL'"
	fi
}

validate_environment() {
	[[ -d "$AVAILABLE" ]] || die "Missing Apache sites-available directory: $AVAILABLE"
	[[ -d "$ENABLED" ]] || die "Missing Apache sites-enabled directory: $ENABLED"
	run_cmd mkdir -p "$LOGSDIR"
}

safe_rm_path() {
	local target="$1"
	if [[ -e "$target" || -L "$target" ]]; then
		run_cmd rm -rf -- "$target"
		echo "Removed $target"
	fi
}

create_www() {
	run_cmd mkdir -p "$WEBDIR/$URL/html"
	run_cmd mkdir -p "$WEBDIR/$URL/dev"
	run_cmd mkdir -p "$WEBDIR/errors/$URL"
	run_cmd mkdir -p "$WEBDIR/access/$URL"

	run_cmd chown -R "$RUN_AS_USER:$RUN_AS_USER" "$WEBDIR/$URL/html"
	run_cmd chown -R "$RUN_AS_USER:$RUN_AS_USER" "$WEBDIR/$URL/dev"
	run_cmd chmod -R 755 "$WEBDIR/$URL"
}

create_wwwdev() {
	run_cmd mkdir -p "$WEBDIR/$URL/dev"
	run_cmd chown -R "$RUN_AS_USER:$RUN_AS_USER" "$WEBDIR/$URL/dev"
	run_cmd chmod -R 755 "$WEBDIR/$URL"
}

create_index() {
	run_cmd mkdir -p "$WEBDIR/$URL/html"
	if [[ "$DRYRUN" -eq 1 ]]; then
		echo "[DRYRUN] write $WEBDIR/$URL/html/index.php"
	else
		cat > "$WEBDIR/$URL/html/index.php" <<'EOF'
<?php include ('/srv/lib/polyphony/init.php');?>
EOF
	fi
}

write_main_vhost() {
	if [[ "$DRYRUN" -eq 1 ]]; then
		echo "[DRYRUN] write $AVAILABLE/$URL.conf"
		return 0
	fi
	cat > "$AVAILABLE/$URL.conf" <<EOF
#### $URL ####
<VirtualHost *:80>
		ServerName $URL
		DocumentRoot $WEBDIR/$URL/html
		ServerAdmin $EMAIL
		ServerAlias $URL
		ErrorLog $WEBDIR/$URL/error.log
		CustomLog $WEBDIR/$URL/access.log combined
</VirtualHost>

<VirtualHost *:80>
		DocumentRoot $WEBDIR/$URL/html
		ServerAdmin $EMAIL
		ServerName $URL
		ServerAlias *.$URL
		ErrorLog $WEBDIR/$URL/error.log
		CustomLog $WEBDIR/$URL/access.log combined
</VirtualHost>
EOF
}

write_dev_vhost() {
	if [[ "$DRYRUN" -eq 1 ]]; then
		echo "[DRYRUN] write $AVAILABLE/$DEV.conf"
		return 0
	fi
	cat > "$AVAILABLE/$DEV.conf" <<EOF
#### $DEV ####
<VirtualHost *:80>
		ServerName $DEV
		DocumentRoot $WEBDIR/$URL/dev
		ServerAdmin $EMAIL
		ServerAlias $DEV
		ErrorLog $WEBDIR/$URL/error.log
		CustomLog $WEBDIR/$URL/access.log combined
</VirtualHost>
EOF
}

enable_sites() {
	run_cmd a2ensite "$URL.conf"
	run_cmd a2ensite "$DEV.conf"
}

restart_apache() {
	echo "------ Stability Test ------"
	run_cmd apache2ctl configtest || die "Apache config test failed"
	echo "Restarting Apache2..."
	run_cmd systemctl restart apache2
}

configtest() {
	run_cmd apache2ctl configtest
}

create_htaccess() {
	if [[ "$DRYRUN" -eq 1 ]]; then
		echo "[DRYRUN] write $WEBDIR/$URL/html/.htaccess"
		return 0
	fi
	cat > "$WEBDIR/$URL/html/.htaccess" <<EOF
#Force non.www:
RewriteEngine on
RewriteCond %{HTTP_HOST} ^www\.$WEBSITENAME\.$EXT [NC]
RewriteRule ^(.*)$ https://$URL/\$1 [L,R=301]

Options -MultiViews
<IfModule mod_rewrite.c>
		# polyphony rewrite
		RewriteEngine On
		RewriteBase /
		RewriteCond %{REQUEST_FILENAME} !-f
		RewriteCond %{REQUEST_FILENAME} !-d
		RewriteRule . /index.php [L,NC,QSA]
</IfModule>
EOF
}

create_htaccess_dev() {
	if [[ "$DRYRUN" -eq 1 ]]; then
		echo "[DRYRUN] write $WEBDIR/$URL/dev/.htaccess"
		return 0
	fi
	cat > "$WEBDIR/$URL/dev/.htaccess" <<EOF
#Force non.www:
RewriteEngine on
RewriteCond %{HTTP_HOST} ^www\.dev\.$WEBSITENAME\.$EXT [NC]
RewriteRule ^(.*)$ https://$DEV/\$1 [L,R=301]

Options -MultiViews
<IfModule mod_rewrite.c>
		# polyphony rewrite
		RewriteEngine On
		RewriteBase /
		RewriteCond %{REQUEST_FILENAME} !-f
		RewriteCond %{REQUEST_FILENAME} !-d
		RewriteRule . /index.php [L,NC,QSA]
</IfModule>
EOF
}

set_permissions() {
	run_cmd chown -R "$RUN_AS_USER:$RUN_AS_USER" "$WEBDIR/$URL/html" "$WEBDIR/$URL/dev"
	run_cmd chmod -R 755 "$WEBDIR/$URL"
}

create_assets_dirs() {
	run_cmd mkdir -p \
		"$WEBDIR/$URL/html/assets/css" \
		"$WEBDIR/$URL/html/assets/docs" \
		"$WEBDIR/$URL/html/assets/fonts" \
		"$WEBDIR/$URL/html/assets/includes" \
		"$WEBDIR/$URL/html/assets/js" \
		"$WEBDIR/$URL/html/assets/pics" \
		"$WEBDIR/$URL/html/assets/scripts" \
		"$WEBDIR/$URL/html/assets/templates"
}

certbot_main() {
	echo "Getting SSL certificate via Certbot"
	run_cmd certbot -d "$URL" -d "www.$URL" -d "$DEV"
}

certbot_dev() {
	echo "Getting SSL certificate via Certbot"
	run_cmd certbot -d "$DEV"
}

create_dev() {
	run_cmd mkdir -p "$WEBDIR/$URL/dev"
	run_cmd cp -a "$WEBDIR/$URL/html/." "$WEBDIR/$URL/dev/"
}

remove_www() {
	safe_rm_path "$WEBDIR/$URL"
}

remove_conf() {
	safe_rm_path "$ENABLED/$URL.conf"
	safe_rm_path "$AVAILABLE/$URL.conf"
	safe_rm_path "$ENABLED/$DEV.conf"
	safe_rm_path "$AVAILABLE/$DEV.conf"
	safe_rm_path "$ENABLED/$URL-le-ssl.conf"
	safe_rm_path "$AVAILABLE/$URL-le-ssl.conf"
	safe_rm_path "$ENABLED/$DEV-le-ssl.conf"
	safe_rm_path "$AVAILABLE/$DEV-le-ssl.conf"
}

disable_site() {
	echo "Disabling website..."
	run_cmd a2dissite "$URL.conf" >/dev/null 2>&1 || true
	run_cmd a2dissite "$DEV.conf" >/dev/null 2>&1 || true
}

finish_removal() {
	echo "Success: $URL server blocks removed."
}

create_devsite() {
	echo "Creating dev directory..."
	create_wwwdev
	create_dev
	write_dev_vhost
	run_cmd a2ensite "$DEV.conf"
	create_htaccess_dev
	run_cmd chown -R "$RUN_AS_USER:$RUN_AS_USER" "$WEBDIR/$URL/dev"
	run_cmd chmod -R 755 "$WEBDIR/$URL"
	certbot_dev
}

complete_job() {
	echo "Job done."
}

remove_website() {
	local domain="$1"
	if [[ "$DRYRUN" -eq 1 ]]; then
		echo "[DRYRUN] remove website flow for $domain"
		disable_site
		restart_apache
		remove_www
		remove_conf
		finish_removal
		return 0
	fi
	read -r -p "Are you sure you want to delete $domain? [Y/N] " confirm
	case "$confirm" in
		Y|y)
			echo "Removing $domain ..."
			disable_site
			restart_apache
			remove_www
			remove_conf
			finish_removal
			;;
		N|n)
			echo "Cancelled."
			;;
		*)
			remove_website "$domain"
			;;
	esac
}

create_virtual_host() {
	echo "Creating virtual hosts..."
	safe_rm_path "$ENABLED/$URL.conf"
	safe_rm_path "$AVAILABLE/$URL.conf"
	safe_rm_path "$ENABLED/$DEV.conf"
	safe_rm_path "$AVAILABLE/$DEV.conf"

	write_main_vhost
	write_dev_vhost
	enable_sites
	restart_apache
	complete_job
}

full_suite() {
	echo "--------- Creating website $URL ---------"
	create_www
	echo "Creating $URL homepage ..."
	create_index
	echo "Writing virtual hosts ..."
	write_main_vhost
	# write_dev_vhost
	enable_sites
	restart_apache
	echo "Creating assets directories ..."
	create_assets_dirs
	echo "Initializing .htaccess ..."
	create_htaccess
	# create_htaccess_dev
	echo "Creating dev ..."
	# create_dev
	echo "Finishing up ..."
	echo "Success: $URL server blocks are running."
	echo "To issue certs manually: certbot -d $URL -d www.$URL -d $DEV"
}

full_suite_certbot() {
	full_suite
	echo "Running Certbot ..."
	certbot_main
	echo "Success: $URL server blocks are running with SSL certificates."
}

### LOGIC ###
require_root

if [[ "$SELF_INSTALL" -eq 1 ]]; then
	self_install
	exit 0
fi

if [[ "$SELF_UPDATE" -eq 1 ]]; then
	self_update_from_git
	exit 0
fi

validate_environment

case "$ACTION" in
	-configtest)
		configtest
		;;
	-A|-C|-D|-F|-FC|-H|-I|-P|-R|-SSL|-V)
		validate_domain
		case "$ACTION" in
			-A) create_www; create_assets_dirs ;;
			-C) certbot_main ;;
			-D) create_devsite; complete_job ;;
			-F) full_suite ;;
			-FC) full_suite_certbot ;;
			-H) echo "Creating .htaccess for $URL ..."; create_htaccess ;;
			-I) create_index ;;
			-P) set_permissions ;;
			-R) remove_website "$URL" ;;
			-SSL) certbot_main ;;
			-V) create_virtual_host ;;
		esac
		;;
	*)
		usage
		exit 1
		;;
esac

exit 0
